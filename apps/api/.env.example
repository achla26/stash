# Copy this file to .env and fill in your values.
# Local dev: use your Supabase database URL (Settings -> Database), with ?sslmode=require
DATABASE_URL=postgresql://postgres:your-password@db.xxx.supabase.co:5432/postgres?sslmode=require

# Any long random strings. Keep secret. Change for production.
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret

# Google OAuth web client ID (same value as apps/web/.env)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
